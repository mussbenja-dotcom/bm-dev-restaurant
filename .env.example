# Copiá este archivo como .env y ajustá. No pongas claves de servicios pagos: el sistema no las usa.
APP_ENV=production
PORT=4000
HOST=0.0.0.0
# Dónde se guardan base de datos y fotos (copiar esta carpeta = trasladar el sistema)
DATA_DIR=./data/prod
# Dirección con la que se generan los QR. Si cambia el dominio, cambiá esto y reimprimí los QR.
# PUBLIC_URL=https://mi-restaurante.com.ar
# HTTPS en la red local (opcional, generar con: npm run cert)
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem
# Solo detrás de un proxy con HTTPS (Caddy/nginx): IP del proxy en la que se confía (1 = 127.0.0.1, mismo servidor).
# Con proxy, escuchá solo en localhost (HOST=127.0.0.1) para que nadie saltee el proxy.
# TRUST_PROXY=1
