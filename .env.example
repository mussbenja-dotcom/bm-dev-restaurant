# Copiá este archivo como .env y ajustá. No pongas claves de servicios pagos: el sistema no las usa.
# Nunca subas el .env a git (ya está en .gitignore). En Render, estas variables se cargan en el panel del servicio.
APP_ENV=production
# Render define PORT solo; localmente se usa 4000.
PORT=4000
HOST=0.0.0.0
# Dónde se guardan las fotos y, si no hay DATABASE_URL, también la base embebida (copiar esta carpeta = trasladar el sistema).
DATA_DIR=./data/prod

# PostgreSQL externo (Neon). Si está definida, la base embebida NO se usa. Si no conecta, el servidor no arranca.
# Copiala del panel de Neon (Connection string). Ejemplo con datos ficticios:
# DATABASE_URL=postgresql://USUARIO:CLAVE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Dirección con la que se generan los QR y los enlaces de activación. Si cambia el dominio, cambiá esto y reimprimí los QR.
# En Render, si no la definís, se usa RENDER_EXTERNAL_URL (https://<servicio>.onrender.com).
# PUBLIC_URL=https://mi-restaurante.com.ar

# Proxy delante (para IP real de cada cliente y cookie segura):
#   1         = proxy en el mismo equipo (Caddy/nginx); escuchá solo en localhost (HOST=127.0.0.1).
#   saltos:1  = Render (toma la IP que agrega su balanceador).
# TRUST_PROXY=saltos:1

# Cuenta inicial de Superadmin al arrancar (solo se crea si no existe). Si no ponés clave, el enlace para definirla sale en los registros.
# SUPERADMIN_EMAIL=tu@email.com
# SUPERADMIN_NAME=Tu nombre
# SUPERADMIN_PASSWORD=

# HTTPS en la red local (opcional, generar con: npm run cert). No se usa en Render.
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem
